# 复制本文件为 .env 后填入你自己的值。.env 已在 .gitignore 中，切勿提交。
# 这里只有变量名和假值，不要放真实 key。

# ---- 大模型接口（OpenAI 兼容协议）----
# 不配置时系统不会崩溃，但 12 项里只有 8 项规则项能出分（权重 58/100）：
# 原理阐述 / 数据处理与计算 / 误差分析 / 结论与讨论 这 4 项（权重 42）
# 会显示「未检测」并从总分分母剔除 —— 界面上会有明确提示，不会静默缺席。
# 也就是说：不接 API 只查「格式与结构」，查不了「内容对不对」。
#
# 排查用：python tools/check_api_status.py
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# true 时禁止调用真实模型（用于离线演示排练）；正常评阅请设为 false
# 注意：DEMO_MODE 只拦「用平台配置烧钱」。学生在侧边栏**自带**的密钥仍会放行，
# 因为那花的是学生自己账户的钱。
DEMO_MODE=false

# ---- 平台共享额度（可选，默认关闭）----
# 管理员配一个 key，学生侧边栏就会出现「平台提供额度（免费·学生免配置）」，
# 不用自己填就能用上 4 项 AI 诊断。
# 必须满足两个条件才生效：ENABLE_SHARED_AI=true 且 SHARED_LLM_API_KEY 非空。
# 默认全关 —— 一个公开链接不该能刷爆账单。
# 生产环境请把限额做在服务端（按学号/IP 限流），这里的会话计数只够 demo 用。
ENABLE_SHARED_AI=false
SHARED_LLM_API_KEY=
SHARED_LLM_BASE_URL=
SHARED_LLM_MODEL=
SHARED_DAILY_LIMIT=20
